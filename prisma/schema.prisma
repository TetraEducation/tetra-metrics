generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadIdentifierType {
  EMAIL
  PHONE
}

enum LeadSourceSystem {
  CLINT
  SPREADSHEET
  ACTIVECAMPAIGN
  FORM
}

enum LeadEventType {
  TAG_ADDED
  LEAD_IMPORTED
}

enum JobRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum FormQuestionDataType {
  text
  number
  bool
  date
  select
  unknown
}

model Leads {
  id              String            @id @default(cuid()) @map("lead_id")
  name            String            @map("full_name")
  document        String?           @map("document")
  firstContactAt  DateTime?         @map("first_contact_at") @db.Timestamptz(6)
  lastActivityAt  DateTime?         @map("last_activity_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  identifiers     LeadIdentifiers[]
  sources         LeadSources[]
  tags            LeadTags[]
  events          LeadEvents[]
  formSubmissions FormSubmissions[]
  searchProfile   LeadSearchProfile?

  @@index([lastActivityAt], map: "idx_leads_last_activity")
  @@map("leads")
}

model LeadSearchProfile {
  leadId         String   @id @map("lead_id")
  salaryMin      Decimal? @map("salary_min") @db.Decimal(10, 2)
  salaryMax      Decimal? @map("salary_max") @db.Decimal(10, 2)
  ageMin         Int?     @map("age_min")
  ageMax         Int?     @map("age_max")
  gender         String?  @map("gender")
  companySize    String?  @map("company_size")
  educationLevel String?  @map("education_level")
  excelKnowledge String?  @map("excel_knowledge")
  powerBiKnowledge String?  @map("power_bi_knowledge")
  jobRole        String?  @map("job_role")
  seniorityLevel String?  @map("seniority_level")
  currentCompany String?  @map("current_company")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lead           Leads    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([salaryMin], map: "lead_search_profile_salary_min_idx")
  @@index([salaryMax], map: "lead_search_profile_salary_max_idx")
  @@index([ageMin], map: "lead_search_profile_age_min_idx")
  @@index([ageMax], map: "lead_search_profile_age_max_idx")
  @@index([gender], map: "lead_search_profile_gender_idx")
  @@index([companySize], map: "lead_search_profile_company_size_idx")
  @@index([educationLevel], map: "lead_search_profile_education_level_idx")
  @@index([excelKnowledge], map: "lead_search_profile_excel_knowledge_idx")
  @@index([powerBiKnowledge], map: "lead_search_profile_power_bi_knowledge_idx")
  @@index([jobRole], map: "lead_search_profile_job_role_idx")
  @@index([seniorityLevel], map: "lead_search_profile_seniority_level_idx")
  @@index([currentCompany], map: "lead_search_profile_current_company_idx")
  @@index([salaryMin, salaryMax], map: "lead_search_profile_salary_range_idx")
  @@index([ageMin, ageMax], map: "lead_search_profile_age_range_idx")
  @@map("lead_search_profile")
}

model LeadIdentifiers {
  id              String             @id @default(cuid()) @map("lead_identifier_id")
  leadId          String             @map("lead_id")
  type            LeadIdentifierType @map("type")
  value           String             @map("value")
  valueNormalized String             @map("value_normalized")
  isPrimary       Boolean            @default(false) @map("is_primary")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  lead            Leads              @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([type, valueNormalized], map: "uq_lead_identifiers_type_value_norm")
  @@index([leadId], map: "idx_lead_identifiers_lead_id")
  @@index([leadId, isPrimary(sort: Desc)], map: "idx_lead_identifiers_primary")
  @@map("lead_identifiers")
}

model LeadSources {
  id           String           @id @default(cuid()) @map("lead_source_id")
  leadId       String           @map("lead_id")
  sourceSystem LeadSourceSystem @map("source_system")
  sourceRef    String           @map("source_ref")
  firstSeenAt  DateTime         @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt   DateTime         @map("last_seen_at") @db.Timestamptz(6)
  meta         Json             @map("meta")
  lead         Leads            @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([sourceSystem, sourceRef], map: "uq_lead_sources_system_ref")
  @@index([leadId], map: "idx_lead_sources_lead_id")
  @@map("lead_sources")
}

model Tags {
  id            String        @id @default(cuid()) @map("tag_id")
  key           String        @map("key")
  keyNormalized String        @map("key_normalized")
  name          String        @map("name")
  category      String        @map("category")
  weight        Int           @default(1) @map("weight")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  aliases       TagAliases[]
  leadTags      LeadTags[]
  formSchemas   FormSchemas[]

  @@unique([keyNormalized], map: "uq_tags_key_normalized")
  @@map("tags")
}

model TagAliases {
  id           String @id @default(cuid()) @map("tag_alias_id")
  tagId        String @map("tag_id")
  sourceSystem LeadSourceSystem @map("source_system")
  sourceKey    String @map("source_key")
  tag          Tags   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([sourceSystem, sourceKey], map: "uq_tag_aliases_source_system_key")
  @@index([tagId], map: "idx_tag_aliases_tag_id")
  @@map("tag_aliases")
}

model LeadTags {
  leadId       String   @map("lead_id")
  tagId        String   @map("tag_id")
  sourceSystem LeadSourceSystem   @map("source_system")
  sourceRef    String?  @map("source_ref")
  firstSeenAt  DateTime @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt   DateTime @map("last_seen_at") @db.Timestamptz(6)
  meta         Json     @map("meta")
  lead         Leads    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag          Tags     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId, sourceSystem], map: "pk_lead_tags")
  @@index([tagId], map: "idx_lead_tags_tag_id")
  @@map("lead_tags")
}

model FormSchemas {
  id             String   @id @default(cuid()) @map("form_schema_id")
  sourceSystem   LeadSourceSystem   @map("source_system")
  sourceRef      String   @map("source_ref")
  name           String   @map("name")
  nameNormalized String   @map("name_normalized")
  tagId          String?  @map("tag_id")
  meta           Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  tag           Tags?                 @relation(fields: [tagId], references: [id], onDelete: SetNull)
  questionLinks FormSchemaQuestions[] @relation("SchemaQuestionLinks")
  submissions   FormSubmissions[]     @relation("FormSchemaSubmissions")

  @@unique([sourceSystem, sourceRef], map: "form_schemas_source_system_source_ref_unique")
  @@map("form_schemas")
}

model FormQuestions {
  id            String               @id @default(cuid())
  key           String
  keyNormalized String               @map("key_normalized")
  label         String
  position      Int
  dataType      FormQuestionDataType @default(text) @map("data_type")
  meta          Json                 @default("{}")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)

  schemaLinks FormSchemaQuestions[] @relation("QuestionSchemaLinks")
  answers     FormAnswers[]         @relation("QuestionAnswers")

  @@unique([keyNormalized], map: "form_questions_key_normalized_unique")
  @@map("form_questions")
}

model FormSchemaQuestions {
  formSchemaId String   @map("form_schema_id")
  questionId   String   @map("question_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  formSchema FormSchemas   @relation("SchemaQuestionLinks", fields: [formSchemaId], references: [id], onDelete: Cascade)
  question   FormQuestions @relation("QuestionSchemaLinks", fields: [questionId], references: [id], onDelete: Cascade)

  @@id([formSchemaId, questionId], map: "form_schema_questions_pkey")
  @@index([questionId], map: "form_schema_questions_question_id_idx")
  @@map("form_schema_questions")
}

model FormSubmissions {
  id           String    @id @default(cuid())
  formSchemaId String    @map("form_schema_id")
  leadId       String?   @map("lead_id")
  submittedAt  DateTime? @map("submitted_at") @db.Timestamptz(6)
  sourceRef    String?   @map("source_ref")
  dedupeKey    String?   @map("dedupe_key")
  rawPayload   Json      @default("{}") @map("raw_payload")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  formSchema FormSchemas   @relation("FormSchemaSubmissions", fields: [formSchemaId], references: [id], onDelete: Cascade)
  lead       Leads?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  answers    FormAnswers[] @relation("SubmissionAnswers")

  @@unique([formSchemaId, dedupeKey], map: "form_submissions_form_schema_id_dedupe_key_unique")
  @@index([formSchemaId], map: "form_submissions_form_schema_id_idx")
  @@index([leadId], map: "form_submissions_lead_id_idx")
  @@index([dedupeKey], map: "form_submissions_dedupe_key_idx")
  @@map("form_submissions")
}

model FormAnswers {
  id               String   @id @default(cuid()) @map("form_answer_id")
  formSubmissionId String   @map("form_submission_id")
  questionId       String   @map("question_id")
  valueText        String?  @map("value_text")
  valueNumber      Decimal? @map("value_number") @db.Decimal(10, 2)
  valueBool        Boolean? @map("value_bool")
  valueJson        Json?    @map("value_json")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  submission FormSubmissions @relation("SubmissionAnswers", fields: [formSubmissionId], references: [id], onDelete: Cascade)
  question   FormQuestions   @relation("QuestionAnswers", fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([formSubmissionId, questionId], map: "form_answers_form_submission_id_question_id_unique")
  @@index([formSubmissionId], map: "form_answers_form_submission_id_idx")
  @@index([questionId], map: "form_answers_question_id_idx")
  @@map("form_answers")
}

model LeadEvents {
  id           String           @id @default(cuid()) @map("event_id")
  leadId       String           @map("lead_id")
  eventType    LeadEventType    @map("event_type")
  sourceSystem LeadSourceSystem @map("source_system")
  occurredAt   DateTime         @map("occurred_at") @db.Timestamptz(6)
  ingestedAt   DateTime         @map("ingested_at") @db.Timestamptz(6)
  dedupeKey    String?          @map("dedupe_key")
  payload      Json             @map("payload")
  lead         Leads            @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([dedupeKey], map: "uq_lead_events_dedupe_key")
  @@index([leadId], map: "idx_lead_events_lead_id")
  @@index([sourceSystem], map: "idx_lead_events_source_system")
  @@index([dedupeKey], map: "idx_lead_events_dedupe_key")
  @@map("lead_events")
}

model JobRuns {
  id               String           @id @default(cuid()) @map("job_run_id")
  jobName          String           @map("job_name")
  status           JobRunStatus     @map("status")
  fileName         String           @map("file_name")
  filePath         String           @map("file_path")
  fileHash         String           @map("file_hash")
  sourceSystem     LeadSourceSystem @map("source_system")
  tagKey           String           @map("tag_key")
  startedAt        DateTime?        @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime?        @map("finished_at") @db.Timestamptz(6)
  lastProcessedRow Int              @default(0) @map("last_processed_row")
  totalRows        Int?             @map("total_rows")
  processedRows    Int              @default(0) @map("processed_rows")
  processedOk      Int              @default(0) @map("processed_ok")
  processedErrors  Int              @default(0) @map("processed_errors")
  retryCount       Int              @default(0) @map("retry_count")
  errorMessage     String?          @map("error_message")
  meta             Json             @default("{}")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([status], map: "idx_job_runs_status")
  @@index([createdAt], map: "idx_job_runs_created_at")
  @@index([jobName, status], map: "idx_job_runs_job_name_status")
  @@map("job_runs")
}
